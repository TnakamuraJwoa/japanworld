---
/**
 * 全ページ共通のレイアウト。
 *
 * 日本語単独サイトのため hreflang / og:locale の言語分岐は持たない。
 * （旧 /en/ /zh/ /vi/ の 36URL は worker/index.ts で日本語版へ 301 している）
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, COMPANY } from '../data/site';
import { IMAGES, type ImageName } from '../data/images.generated';

interface Props {
  /** <title> に使う。サイト名はここで付ける */
  title: string;
  description: string;
  /** canonical に使う絶対パス（例 /business/wellness/） */
  path: string;
  /** OGP 画像。ページごとに変える */
  ogImage?: ImageName;
  /** LCP 画像を preload する場合の名前と sizes */
  preloadImage?: { name: ImageName; sizes: string };
  /** 追加の JSON-LD */
  jsonLd?: unknown[];
  noindex?: boolean;
  /** トップページだけ <title> にページ名を重ねない */
  bareTitle?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = 'salon/kame-open',
  preloadImage,
  jsonLd = [],
  noindex = false,
  bareTitle = false,
} = Astro.props;

const canonical = new URL(path, SITE.origin).href;
const fullTitle = bareTitle ? title : `${title} | ${COMPANY.name}`;

const og = IMAGES[ogImage];
const ogUrl = new URL(`/images/${ogImage}-${og.widths[og.widths.length - 1]}.webp`, SITE.origin).href;

const preload = preloadImage
  ? {
      srcset: IMAGES[preloadImage.name].widths
        .map((w: number) => `/images/${preloadImage.name}-${w}.webp ${w}w`)
        .join(', '),
      href: `/images/${preloadImage.name}-${IMAGES[preloadImage.name].widths[0]}.webp`,
      sizes: preloadImage.sizes,
    }
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
    <meta property="og:site_name" content={COMPANY.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#062f4a" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      preload && (
        <link
          rel="preload"
          as="image"
          href={preload.href}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      )
    }

    {
      jsonLd.map((data) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
      ))
    }
  </head>

  <body id="top">
    <a class="skip" href="#main">本文へスキップ</a>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/*
      スクロールで要素を浮かび上がらせる。
      - 外部ライブラリは使わない（IntersectionObserver のみ）
      - prefers-reduced-motion: reduce のときは何もしない
      - この属性が付いて初めて CSS 側が .reveal を隠すので、
        JavaScript が無効な環境では最初から表示されたままになる
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        root.setAttribute('data-reveal', '');

        var show = function (el) {
          el.classList.add('is-visible');
        };

        var io = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) {
                show(entries[i].target);
                io.unobserve(entries[i].target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 },
        );

        var targets = document.querySelectorAll('.reveal');
        for (var i = 0; i < targets.length; i++) {
          // ファーストビュー内にある要素は、待たずにすぐ出す
          if (targets[i].getBoundingClientRect().top < window.innerHeight * 0.9) {
            show(targets[i]);
          } else {
            io.observe(targets[i]);
          }
        }
      })();
    </script>
  </body>
</html>
