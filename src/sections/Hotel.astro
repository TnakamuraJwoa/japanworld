---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { pathFor, HOTEL, bookingUrl, type Lang, type RouteKey } from '../data/site';
import type { Dict } from '../i18n/types';
import type { ImageName } from '../data/images.generated';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.hotel;

const facilities: { key: RouteKey; img: ImageName }[] = [
  { key: 'rooms', img: 'rooms/royal-living' },
  { key: 'spa', img: 'spa/daiyokujo' },
  { key: 'dining', img: 'dining/restaurant' },
  { key: 'banquet', img: 'banquet/hall' },
  { key: 'salon', img: 'salon/interior' },
  { key: 'nasu', img: 'nasu/ropeway-autumn' },
];

const facts: [string, string][] = [
  [t.pages.home.facts[0][0], HOTEL.addressFull],
  [t.pages.home.facts[1][0], t.pages.home.facts[1][1]],
  [t.pages.home.facts[2][0], t.pages.home.facts[2][1]],
  [t.pages.home.facts[3][0], t.pages.home.facts[3][1]],
  [t.pages.home.facts[5][0], t.pages.home.facts[5][1]],
];
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="hotel/entrance" />
<Breadcrumbs lang={lang} t={t} trail={['hotel']} />

<section class="section">
  <div class="wrap split">
    <div class="split__text">
      {p.introBody.map((x) => <p>{x}</p>)}
      <dl class="dl">
        {
          facts.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <figure class="figure">
      <Picture name="hotel/exterior" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap">
    <p class="eyebrow">Facilities</p>
    <h2 class="section-title">{p.facilitiesHeading}</h2>
    <hr class="rule" />
    <p class="lead-sp">{p.facilitiesLead}</p>
    <div class="grid grid--3 facilities">
      {
        facilities.map((f) => (
          <article class="card card--link">
            <div class="card__media">
              <Picture
                name={f.img}
                sizes="(min-width: 1000px) 33vw, (min-width: 640px) 48vw, 92vw"
              />
            </div>
            <div class="card__body">
              <h3 class="card__title">
                <a class="stretch" href={pathFor(lang, f.key)}>
                  {t.nav[f.key]}
                </a>
              </h3>
              <p class="card__link">{t.ui.readMore} →</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Lobby</p>
    <h2 class="section-title">{p.lobbyHeading}</h2>
    <hr class="rule" />
    <div class="split lobby">
      <div class="split__text">
        {p.lobbyBody.map((x) => <p>{x}</p>)}
      </div>
      <figure class="figure">
        <Picture name="lobby/atrium" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
      </figure>
    </div>
    <div class="grid grid--4 lobbyCards">
      {
        p.lobbyCards.map((c) => (
          <article class="mini">
            <h3 class="mini__title">{c.title}</h3>
            <p class="mini__body">{c.body}</p>
          </article>
        ))
      }
    </div>
    <div class="grid grid--3 lobbyGallery">
      <figure class="figure"><Picture name="lobby/front-desk" sizes="(min-width: 1000px) 33vw, 92vw" ratio="3/2" /></figure>
      <figure class="figure"><Picture name="lobby/sofa" sizes="(min-width: 1000px) 33vw, 92vw" ratio="3/2" /></figure>
      <figure class="figure"><Picture name="lobby/front-flowers" sizes="(min-width: 1000px) 33vw, 92vw" ratio="3/2" /></figure>
    </div>
  </div>
</section>

<section class="section section--ai">
  <div class="wrap split split--reverse">
    <div class="split__text">
      <p class="eyebrow">Hospitality</p>
      <h2 class="section-title">{p.hospitalityHeading}</h2>
      <hr class="rule" />
      <p class="h-lead hospitality__lead">{p.hospitalityLead}</p>
      {p.hospitalityBody.map((x) => <p>{x}</p>)}
    </div>
    <figure class="figure">
      <Picture name="rooms/lantern" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap grid grid--2">
    <article class="panel">
      <p class="eyebrow">Salon</p>
      <h2 class="panel__title">{p.salonTeaserHeading}</h2>
      <p class="panel__body">{p.salonTeaserBody}</p>
      <p class="btn-row">
        <a class="btn btn--ghost" href={pathFor(lang, 'salon')}>{t.nav.salon}</a>
      </p>
    </article>
    <article class="panel">
      <p class="eyebrow">Official site</p>
      <h2 class="panel__title">{p.hotelSiteHeading}</h2>
      <p class="panel__body">{p.hotelSiteBody}</p>
      <p class="btn-row">
        <a class="btn btn--primary ext" href={bookingUrl(lang)} target="_blank" rel="noopener">
          {t.booking.generalCta}
        </a>
      </p>
    </article>
  </div>
</section>

<style>
  .lead-sp {
    margin-top: 1.25rem;
    color: var(--ink-70);
    max-width: 56ch;
  }

  .facilities,
  .lobbyCards,
  .lobbyGallery {
    margin-top: 2.25rem;
  }

  .facilities .card__title a {
    text-decoration: none;
    color: inherit;
  }

  .facilities .card--link:hover .card__title a {
    color: var(--ai-700);
  }

  .lobby {
    margin-top: 2rem;
  }

  .mini {
    border-top: 2px solid var(--line);
    padding-top: 1rem;
  }

  .mini__title {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }

  .mini__body {
    font-size: var(--step--1);
    color: var(--ink-70);
    line-height: 1.9;
  }

  .hospitality__lead {
    color: #fff;
  }

  .panel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .panel__title {
    font-size: var(--step-2);
  }

  .panel__body {
    color: var(--ink-70);
    font-size: var(--step--1);
    line-height: 1.95;
    flex: 1;
  }
</style>
