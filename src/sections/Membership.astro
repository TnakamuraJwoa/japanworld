---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { COMPANY, EXTERNAL, pathFor, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.membership;
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="rooms/living" />
<Breadcrumbs lang={lang} t={t} trail={['membership']} />

<section class="section">
  <div class="wrap membership">
    <div class="membership__main stack">
      <h2 class="section-title">{p.summaryHeading}</h2>
      <hr class="rule" />
      <ul class="ticks terms">
        {p.terms.map((x) => <li>{x}</li>)}
      </ul>

      <h2 class="section-title mt">{p.facilityHeading}</h2>
      <hr class="rule" />
      <dl class="dl">
        {
          p.facilityRows.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>

      <h2 class="section-title mt">{p.feeHeading}</h2>
      <hr class="rule" />
      <dl class="dl">
        {
          p.feeRows.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>

      <h2 class="section-title mt">{p.reserveHeading}</h2>
      <hr class="rule" />
      <ul class="ticks terms">
        {p.reserveBody.map((x) => <li>{x}</li>)}
      </ul>

      <p class="callout disclaimer">{p.disclaimer}</p>
    </div>

    <aside class="membership__side">
      <div class="sticky">
        <figure class="figure sideFig">
          <Picture name="rooms/royal-living" sizes="(min-width: 1000px) 30vw, 92vw" ratio="3/2" />
        </figure>

        <div class="sideBox">
          <h2 class="sideBox__title">{t.booking.membersTitle}</h2>
          <p class="sideBox__body">{t.booking.membersBody}</p>
          <a class="btn btn--primary ext" href={EXTERNAL.members} target="_blank" rel="noopener">
            {t.booking.membersCta}
          </a>
          <ul class="sideBox__links">
            <li>
              <a class="ext" href={EXTERNAL.membersTerms} target="_blank" rel="noopener">JWCCS</a>
            </li>
          </ul>
        </div>

        <div class="sideBox">
          <h2 class="sideBox__title">{p.contactHeading}</h2>
          <p class="sideBox__body">{p.contactBody}</p>
          <p class="sideBox__tel">
            <a href={`tel:${COMPANY.telHref}`}>TEL {COMPANY.tel}</a>
          </p>
          <p class="sideBox__body">
            <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
          </p>
          <p class="sideBox__body">
            <a href={pathFor(lang, 'company')}>{t.nav.company}</a>
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .membership {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 1000px) {
    .membership {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }

  .terms {
    margin-top: 1.25rem;
  }

  .mt {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .disclaimer {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .sticky {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 1000px) {
    .sticky {
      position: sticky;
      top: 100px;
    }
  }

  .sideFig img {
    border-radius: var(--radius);
  }

  .sideBox {
    background: var(--paper-2);
    border: 1px solid var(--line-soft);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    display: grid;
    gap: 0.7rem;
  }

  .sideBox__title {
    font-size: var(--step-1);
  }

  .sideBox__body {
    font-size: var(--step--1);
    color: var(--ink-70);
    line-height: 1.9;
    margin: 0;
  }

  .sideBox .btn {
    justify-self: start;
  }

  .sideBox__links {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
  }

  .sideBox__tel {
    margin: 0;
  }

  .sideBox__tel a {
    font-family: var(--serif);
    font-size: var(--step-2);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .sideBox__tel a:hover {
    text-decoration: underline;
  }
</style>
