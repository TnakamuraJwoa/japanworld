---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import {
  HOTEL,
  HOTEL_ADDRESS_I18N,
  COMPANY,
  COMPANY_I18N,
  EXTERNAL,
  type Lang,
} from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.access;
const hotelAddress = HOTEL_ADDRESS_I18N[lang];
const companyAddress = COMPANY_I18N[lang].address;
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="hotel/exterior" />
<Breadcrumbs lang={lang} t={t} trail={['access']} />

<!-- 住所・電話 -->
<section class="section section--tight">
  <div class="wrap">
    <h2 class="section-title">{p.addressHeading}</h2>
    <hr class="rule" />
    <div class="addr">
      <dl class="dl addr__dl">
        <div class="dl__row">
          <dt>{t.ui.addressLabel}</dt>
          <dd>〒{HOTEL.postal}　{hotelAddress}</dd>
        </div>
        <div class="dl__row">
          <dt>{t.ui.telLabel}</dt>
          <dd>
            <a class="telLink" href={`tel:${HOTEL.telHref}`}>{HOTEL.tel}</a>
            <span class="muted small">（{t.ui.telHoursLabel} {HOTEL.telHours}）</span>
          </dd>
        </div>
        <div class="dl__row">
          <dt>FAX</dt>
          <dd>{HOTEL.fax}</dd>
        </div>
        <div class="dl__row">
          <dt>{p.parkingHeading}</dt>
          <dd>{p.parkingBody}</dd>
        </div>
      </dl>
      <p class="btn-row">
        <a class="btn btn--primary ext" href={HOTEL.mapUrl} target="_blank" rel="noopener">
          {p.mapCta}
        </a>
      </p>
    </div>
  </div>
</section>

<!-- 車 -->
<section class="section section--paper">
  <div class="wrap grid grid--2">
    <article class="panel">
      <p class="eyebrow">By car</p>
      <h2 class="panel__title">{p.byCarHeading}</h2>
      <ul class="ticks">
        {p.byCarBody.map((x) => <li>{x}</li>)}
      </ul>
    </article>

    <article class="panel">
      <p class="eyebrow">By train</p>
      <h2 class="panel__title">{p.byTrainHeading}</h2>
      <ul class="ticks">
        {p.byTrainBody.map((x) => <li>{x}</li>)}
      </ul>
      <figure class="figure mapFig">
        <Picture name="access/map-nasushiobara" sizes="(min-width: 860px) 46vw, 92vw" />
      </figure>
    </article>
  </div>
</section>

<!-- バス・送迎 -->
<section class="section">
  <div class="wrap split">
    <div class="split__text">
      <p class="eyebrow">By bus</p>
      <h2 class="section-title">{p.byBusHeading}</h2>
      <hr class="rule" />
      <ul class="ticks">
        {p.byBusBody.map((x) => <li>{x}</li>)}
      </ul>
      <p class="btn-row">
        <a class="btn btn--ghost ext" href={EXTERNAL.busTimetable} target="_blank" rel="noopener">
          {p.busTimetableCta}
        </a>
      </p>

      <h3 class="section-title mt">{p.aroundStopHeading}</h3>
      <hr class="rule" />
      <ul class="ticks">
        {p.aroundStopBody.map((x) => <li>{x}</li>)}
      </ul>
    </div>
    <figure class="figure">
      <Picture name="access/map-ichikenjaya" sizes="(min-width: 860px) 46vw, 92vw" />
    </figure>
  </div>
</section>

<!-- 送迎バス -->
<section class="section section--ai">
  <div class="wrap-narrow shuttle">
    <p class="eyebrow">Shuttle</p>
    <h2 class="section-title">{p.shuttleHeading}</h2>
    <hr class="rule" />
    <ul class="ticks shuttle__list">
      {p.shuttleBody.map((x) => <li>{x}</li>)}
    </ul>
    <p class="shuttle__tel">
      <a href={`tel:${HOTEL.telHref}`}>TEL {HOTEL.tel}</a>
    </p>
  </div>
</section>

<!-- 本社 -->
<section class="section section--paper section--tight">
  <div class="wrap">
    <h2 class="section-title">{p.officeHeading}</h2>
    <hr class="rule" />
    <p class="officeLead">{p.officeBody}</p>
    <dl class="dl addr__dl">
      <div class="dl__row">
        <dt>{t.ui.addressLabel}</dt>
        <dd>〒{COMPANY.postal}　{companyAddress}</dd>
      </div>
      <div class="dl__row">
        <dt>{t.ui.telLabel}</dt>
        <dd><a class="telLink" href={`tel:${COMPANY.telHref}`}>{COMPANY.tel}</a></dd>
      </div>
      <div class="dl__row">
        <dt>E-mail</dt>
        <dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .addr {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.5rem;
  }

  .addr__dl {
    max-width: 46rem;
  }

  .telLink {
    font-family: var(--serif);
    font-size: var(--step-2);
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-block;
    min-height: 40px;
  }

  .telLink:hover {
    text-decoration: underline;
  }

  .panel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .panel__title {
    font-size: var(--step-2);
  }

  .mapFig {
    margin-top: auto;
  }

  .mt {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .shuttle {
    text-align: left;
  }

  .shuttle__list {
    margin-top: 1.25rem;
  }

  .shuttle__list li::before {
    background: var(--gold-soft);
  }

  .shuttle__tel {
    margin-top: 1.5rem;
  }

  .shuttle__tel a {
    color: #fff;
    font-family: var(--serif);
    font-size: var(--step-3);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .shuttle__tel a:hover {
    text-decoration: underline;
  }

  .officeLead {
    margin-block: 1.25rem;
    color: var(--ink-70);
  }
</style>
