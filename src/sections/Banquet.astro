---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { HOTEL, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.banquet;
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="banquet/hall" />
<Breadcrumbs lang={lang} t={t} trail={['hotel', 'banquet']} />

<section class="section section--tight">
  <div class="wrap-narrow">
    <p class="h-lead">{p.introBody}</p>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap grid grid--2">
    <article class="panel">
      <p class="eyebrow">Capacity</p>
      <h2 class="panel__title">{p.capacityHeading}</h2>
      <p class="panel__body">{p.capacityBody}</p>
    </article>
    <article class="panel">
      <p class="eyebrow">Use</p>
      <h2 class="panel__title">{p.useHeading}</h2>
      <p class="panel__body">{p.useBody}</p>
    </article>
  </div>

  <div class="wrap grid grid--2 gallery">
    <figure class="figure">
      <Picture name="banquet/hall-wide" sizes="(min-width: 860px) 46vw, 92vw" ratio="3/2" />
    </figure>
    <figure class="figure">
      <Picture name="banquet/hall-floor" sizes="(min-width: 860px) 46vw, 92vw" ratio="3/2" />
    </figure>
  </div>
</section>

<section class="section">
  <div class="wrap-narrow contact">
    <h2 class="section-title">{p.contactHeading}</h2>
    <hr class="rule" />
    <p>{p.contactBody}</p>
    <p class="contact__tel">
      <a href={`tel:${HOTEL.telHref}`}>TEL {HOTEL.tel}</a>
      <span>{t.ui.telHoursLabel} {HOTEL.telHours}</span>
    </p>
  </div>
</section>

<style>
  .panel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .panel__title {
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }

  .panel__body {
    color: var(--ink-70);
    font-size: var(--step--1);
    line-height: 1.95;
  }

  .gallery {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .contact {
    text-align: center;
  }

  .contact hr {
    margin-inline: auto;
  }

  .contact p {
    margin-top: 1rem;
  }

  .contact__tel {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .contact__tel a {
    font-family: var(--serif);
    font-size: var(--step-3);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .contact__tel a:hover {
    text-decoration: underline;
  }

  .contact__tel span {
    font-size: var(--step--1);
    color: var(--ink-50);
  }
</style>
