---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { COMPANY, COMPANY_I18N, EXTERNAL, FEATURES, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.company;

// 事実（電話番号・メール）は COMPANY、言語別の表記は COMPANY_I18N が単一の出典。
// 現行サイトは言語ごとに住所も代表者名も割れていたため、ここで 1 本化している。
const c = COMPANY_I18N[lang];

// JW NFT Platform は TLS 証明書失効のためカードごと非表示。
// 文言は i18n に残してあるので、FEATURES.nftLink を true に戻せば復旧する。
const groupLinks = p.group.filter((g) => g.href !== 'nft' || FEATURES.nftLink);

const rows: [string, string][] = [
  [p.labels.name, c.name],
  [p.labels.address, `〒${COMPANY.postal}　${c.address}`],
  [p.labels.tel, COMPANY.tel],
  [p.labels.email, COMPANY.email],
  [p.labels.capital, c.capital],
  [p.labels.ceo, c.ceo],
];
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="lobby/atrium" />
<Breadcrumbs lang={lang} t={t} trail={['company']} />

<section class="section">
  <div class="wrap split">
    <div class="split__text">
      <h2 class="section-title">{p.profileHeading}</h2>
      <hr class="rule" />
      <dl class="dl">
        {
          rows.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>
                {k === p.labels.tel ? (
                  <a class="telLink" href={`tel:${COMPANY.telHref}`}>
                    {v}
                  </a>
                ) : k === p.labels.email ? (
                  <a href={`mailto:${COMPANY.email}`}>{v}</a>
                ) : (
                  v
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <figure class="figure logoFig">
      <Picture name="brand/jw-mark" sizes="(min-width: 860px) 20vw, 40vw" class="logoImg" />
    </figure>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap">
    <h2 class="section-title">{p.businessHeading}</h2>
    <hr class="rule" />
    <ul class="ticks business">
      {p.business.map((x) => <li>{x}</li>)}
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="section-title">{p.groupHeading}</h2>
    <hr class="rule" />
    <p class="groupLead">{p.groupLead}</p>
    <div class="grid grid--3 group">
      {
        groupLinks.map((g) => (
          <article class="card card--link">
            <div class="card__body">
              <h3 class="card__title">
                <a
                  class="stretch ext"
                  href={EXTERNAL[g.href as keyof typeof EXTERNAL]}
                  target="_blank"
                  rel="noopener"
                >
                  {g.title}
                </a>
              </h3>
              <p class="card__text">{g.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .telLink {
    text-decoration: none;
    display: inline-block;
    min-height: 32px;
    font-weight: 600;
  }

  .telLink:hover {
    text-decoration: underline;
  }

  .logoFig {
    display: grid;
    place-items: center;
    padding: clamp(2rem, 6vw, 4rem);
    background: var(--paper-2);
  }

  .logoFig :global(.logoImg) {
    max-width: min(240px, 60%);
  }

  .business {
    margin-top: 1.5rem;
    columns: 2;
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }

  @media (max-width: 700px) {
    .business {
      columns: 1;
    }
  }

  .business li {
    break-inside: avoid;
  }

  .groupLead {
    margin-block: 1.25rem 0;
    color: var(--ink-70);
  }

  .group {
    margin-top: 2rem;
  }

  .group .card__title a {
    text-decoration: none;
    color: inherit;
  }

  .group .card--link:hover .card__title a {
    color: var(--ai-700);
  }
</style>
