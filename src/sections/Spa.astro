---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import type { Lang } from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.spa;
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="spa/daiyokujo-wide" />
<Breadcrumbs lang={lang} t={t} trail={['hotel', 'spa']} />

<section class="section section--tight">
  <div class="wrap-narrow">
    {p.introBody.map((x) => <p class="h-lead">{x}</p>)}
  </div>
</section>

<!-- 大浴場 -->
<section class="section section--paper">
  <div class="wrap split">
    <div class="split__text">
      <p class="eyebrow">Public bath</p>
      <h2 class="section-title">{p.daiyokujoHeading}</h2>
      <hr class="rule" />
      {p.daiyokujoBody.map((x) => <p>{x}</p>)}
    </div>
    <figure class="figure">
      <Picture name="spa/daiyokujo-view" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<!-- 露天風呂 -->
<section class="section">
  <div class="wrap split split--reverse">
    <div class="split__text">
      <p class="eyebrow">Open-air bath</p>
      <h2 class="section-title">{p.rotenburoHeading}</h2>
      <hr class="rule" />
      {p.rotenburoBody.map((x) => <p>{x}</p>)}
    </div>
    <figure class="figure">
      <Picture name="hero/rotenburo-autumn" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>

  <div class="wrap grid grid--2 gallery">
    <figure class="figure">
      <Picture name="spa/rotenburo-night" sizes="(min-width: 860px) 46vw, 92vw" ratio="3/2" />
    </figure>
    <figure class="figure">
      <Picture name="spa/daiyokujo-entrance" sizes="(min-width: 860px) 46vw, 92vw" ratio="3/2" />
    </figure>
  </div>
</section>

<!-- ご利用時間・温泉について -->
<section class="section section--paper">
  <div class="wrap grid grid--2">
    <article class="panel">
      <p class="eyebrow">Hours</p>
      <h2 class="panel__title">{p.hoursHeading}</h2>
      <dl class="dl">
        {
          p.hoursRows.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="notes spaNote"><span>{p.note}</span></p>
    </article>

    <article class="panel">
      <p class="eyebrow">Onsen</p>
      <h2 class="panel__title">{p.onsenHeading}</h2>
      <dl class="dl dl--stack">
        {
          p.onsenRows.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </article>
  </div>
</section>

<!-- 脱衣所 -->
<section class="section">
  <div class="wrap split">
    <div class="split__text">
      <p class="eyebrow">Changing room</p>
      <h2 class="section-title">{p.changingHeading}</h2>
      <hr class="rule" />
      <p>{p.changingBody}</p>
    </div>
    <figure class="figure">
      <Picture name="spa/changing-room" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<style>
  .gallery {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .panel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
  }

  .panel__title {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
  }

  .spaNote {
    margin-top: 1rem;
  }

  /* 効能は項目数が多く、横並びだと右側で細く折り返るためラベルを上に置く */
  .dl--stack :global(.dl__row) {
    grid-template-columns: 1fr;
    gap: 0.35rem;
  }

  .dl--stack :global(.dl__row) dt {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }
</style>
