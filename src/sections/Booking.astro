---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookingRoutes from '../components/BookingRoutes.astro';
import { HOTEL, BOOKING_MANUAL, EXTERNAL, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.booking;
const sizeMb = (BOOKING_MANUAL.bytes / 1024 / 1024).toFixed(1);
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="hotel/reception" />
<Breadcrumbs lang={lang} t={t} trail={['booking']} />

<section class="section">
  <div class="wrap">
    <h2 class="section-title">{p.chooseHeading}</h2>
    <hr class="rule" />
    <p class="h-lead choose__lead">{p.chooseLead}</p>
    <div class="choose">
      <BookingRoutes lang={lang} t={t} level={3} />
    </div>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap grid grid--2">
    <article class="panel">
      <p class="eyebrow">Manual</p>
      <h2 class="panel__title">{p.manualHeading}</h2>
      <p class="panel__body">{p.manualBody}</p>
      <p class="btn-row">
        <a class="btn btn--ghost" href={BOOKING_MANUAL.href} download>
          {p.manualCta}（{sizeMb} MB）
        </a>
      </p>
    </article>

    <article class="panel">
      <p class="eyebrow">Contact</p>
      <h2 class="panel__title">{p.telHeading}</h2>
      <p class="panel__body">{p.telBody}</p>
      <p class="panel__tel">
        <a href={`tel:${HOTEL.telHref}`}>TEL {HOTEL.tel}</a>
        <span>{t.ui.telHoursLabel} {HOTEL.telHours}</span>
      </p>
    </article>
  </div>
</section>

<section class="section">
  <div class="wrap-narrow">
    <h2 class="section-title">{p.notesHeading}</h2>
    <hr class="rule" />
    <ul class="notes bookingNotes">
      {p.notes.map((n) => <li>{n}</li>)}
    </ul>
    <p class="btn-row bookingLinks">
      <a class="btn btn--ghost ext" href={EXTERNAL.hotelSite} target="_blank" rel="noopener">
        {t.footer.hotelSiteLabel}
      </a>
      <a class="btn btn--ghost ext" href={EXTERNAL.nasuTown} target="_blank" rel="noopener">
        {p.nasuTaxCta}
      </a>
    </p>
  </div>
</section>

<style>
  .choose__lead {
    margin-top: 1.25rem;
  }

  .choose {
    margin-top: 2rem;
  }

  .panel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .panel__title {
    font-size: var(--step-2);
  }

  .panel__body {
    color: var(--ink-70);
    font-size: var(--step--1);
    line-height: 1.95;
    flex: 1;
  }

  .panel__tel {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .panel__tel a {
    font-family: var(--serif);
    font-size: var(--step-3);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .panel__tel a:hover {
    text-decoration: underline;
  }

  .panel__tel span {
    font-size: var(--step--1);
    color: var(--ink-50);
  }

  .bookingNotes {
    margin-top: 1.5rem;
  }

  .bookingLinks {
    margin-top: 2rem;
  }
</style>
