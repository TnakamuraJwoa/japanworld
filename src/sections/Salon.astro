---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { HOTEL, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.salon;
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="salon/kame-room" />
<Breadcrumbs lang={lang} t={t} trail={['hotel', 'salon']} />

<!-- コンセプト -->
<section class="section section--tight">
  <div class="wrap-narrow stack">
    {p.introBody.map((x, i) => <p class={i === 0 ? 'h-lead' : undefined}>{x}</p>)}
  </div>
</section>

<!-- 太古の甕とは -->
<section class="section section--paper">
  <div class="wrap split">
    <div class="split__text">
      <p class="eyebrow">Taiko-no-Kame</p>
      <h2 class="section-title">{p.kameHeading}</h2>
      <hr class="rule" />
      {p.kameBody.map((x) => <p>{x}</p>)}
    </div>
    <figure class="figure">
      <Picture name="salon/kame-open" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<!-- 樹紋石 -->
<section class="section">
  <div class="wrap split split--reverse">
    <div class="split__text">
      <p class="eyebrow">Jumon-seki</p>
      <h2 class="section-title">{p.stoneHeading}</h2>
      <hr class="rule" />
      {p.stoneBody.map((x) => <p>{x}</p>)}
    </div>
    <figure class="figure">
      <Picture name="salon/jumonseki" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<!-- ご利用案内 -->
<section class="section section--paper">
  <div class="wrap info">
    <div class="info__main">
      <p class="eyebrow">Information</p>
      <h2 class="section-title">{p.infoHeading}</h2>
      <hr class="rule" />
      <dl class="dl info__dl">
        {
          p.infoRows.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="notes info__note">{p.infoNote}</p>
    </div>

    <aside class="info__tel">
      <p class="info__telLabel">{t.ui.telLabel}</p>
      <p class="info__telNum">
        <a href={`tel:${HOTEL.telHref}`}>{HOTEL.tel}</a>
      </p>
      <p class="info__telHours">{t.ui.telHoursLabel} {HOTEL.telHours}</p>
    </aside>
  </div>
</section>

<!-- ご入浴の流れ -->
<section class="section">
  <div class="wrap">
    <p class="eyebrow">Flow</p>
    <h2 class="section-title">{p.flowHeading}</h2>
    <hr class="rule" />
    <ol class="flow">
      {
        p.flow.map((s, i) => (
          <li class="flow__step">
            <p class="flow__num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="flow__title">{s.title}</h3>
            <p class="flow__body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- ご注意とお願い -->
<section class="section section--paper">
  <div class="wrap-narrow">
    <h2 class="section-title">{p.cautionHeading}</h2>
    <hr class="rule" />
    <ul class="notes cautions">
      {p.cautions.map((x) => <li>{x}</li>)}
    </ul>
    <p class="callout disclaimer">{p.disclaimer}</p>
  </div>
</section>

<!-- ===================== Esthetic Salon RICHIA ===================== -->
<section class="section section--ai">
  <div class="wrap split">
    <div class="split__text">
      <p class="eyebrow">{p.estheticHeading}</p>
      <h2 class="section-title">{p.estheticName}</h2>
      <hr class="rule" />
      {p.estheticBody.map((x) => <p>{x}</p>)}
    </div>
    <figure class="figure">
      <Picture name="salon/esthetic-room" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="esthetic">
    <div class="esthetic__info">
      <p class="eyebrow">{p.estheticName}</p>
      <h3 class="section-title">{p.infoHeading}</h3>
      <hr class="rule" />
      <dl class="dl">
        {
          p.estheticInfoRows.map(([k, v]) => (
            <div class="dl__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="notes estheticNote"><span>{p.infoNote}</span></p>
    </div>

    <div class="esthetic__menu">
      <h3 class="section-title">{p.menuHeading}</h3>
      <hr class="rule" />

      <p class="menu__group">{p.menuFacialHeading}</p>
      <dl class="dl menu">
        {
          p.menuFacial.map(([k, v]) => (
            <div class="dl__row menu__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>

      <p class="menu__group">{p.menuBodyHeading}</p>
      <dl class="dl menu">
        {
          p.menuBody.map(([k, v]) => (
            <div class="dl__row menu__row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>

      <p class="notes menuNote"><span>{p.menuNote}</span></p>
    </div>
    </div>

    <div class="grid grid--2 estheticPics">
      <figure class="figure">
        <Picture name="salon/esthetic-facial" sizes="(min-width: 860px) 46vw, 92vw" ratio="3/2" />
      </figure>
      <figure class="figure">
        <Picture name="salon/esthetic-body" sizes="(min-width: 860px) 46vw, 92vw" ratio="3/2" />
      </figure>
    </div>
  </div>
</section>

<style>
  /* ---------------- ご利用案内 ---------------- */
  .info {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 860px) {
    .info {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    }
  }

  .info__dl {
    margin-top: 1.75rem;
  }

  .info__note {
    margin-top: 1rem;
  }

  .info__tel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-top: 3px solid var(--ai-700);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    text-align: center;
  }

  .info__telLabel {
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    color: var(--ink-50);
  }

  .info__telNum {
    margin-top: 0.35rem;
  }

  .info__telNum a {
    font-family: var(--serif);
    font-size: var(--step-3);
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-block;
    min-height: 44px;
  }

  .info__telNum a:hover {
    text-decoration: underline;
  }

  .info__telHours {
    font-size: var(--step--1);
    color: var(--ink-50);
  }

  /* ---------------- ご入浴の流れ ---------------- */
  .flow {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    counter-reset: step;
  }

  .flow__step {
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-top: 2px solid var(--line);
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
  }

  .flow__num {
    font-family: var(--serif);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 0.5rem;
  }

  .flow__title {
    font-size: var(--step-0);
    margin-bottom: 0.5rem;
    /* 「カウンセリング・注意事項」が語中で折れないように。
       未対応ブラウザでは通常の折返しに戻るだけ。 */
    word-break: auto-phrase;
  }

  .flow__body {
    font-size: var(--step--1);
    color: var(--ink-70);
    line-height: 1.9;
  }

  /* ---------------- ご注意 ---------------- */
  .cautions {
    margin-top: 1.75rem;
    gap: 0.75rem;
  }

  .cautions li::before {
    content: '・';
    color: var(--ai-500);
  }

  .disclaimer {
    margin-top: 2rem;
  }

  /* ---------------- エステサロン ---------------- */
  .esthetic {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .esthetic {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }

  .estheticNote {
    margin-top: 1rem;
  }

  .estheticPics {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .menu__group {
    margin-top: 1.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--ai-700);
  }

  .menu {
    margin-top: 0.5rem;
  }

  .menu__row {
    grid-template-columns: 1fr auto;
    gap: 0 1rem;
    align-items: baseline;
  }

  .menu__row dt {
    color: var(--ink);
    font-weight: 400;
    font-size: var(--step-0);
  }

  .menu__row dd {
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--ai-800);
    white-space: nowrap;
  }

  .menuNote {
    margin-top: 1.25rem;
  }
</style>
