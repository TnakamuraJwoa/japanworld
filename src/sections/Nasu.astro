---
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Picture from '../components/Picture.astro';
import { pathFor, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';
import type { ImageName } from '../data/images.generated';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.nasu;

const aroundImages: ImageName[] = [
  'nasu/spot-yahata',
  'nasu/spot-sesshoseki',
  'nasu/spot-observatory',
  'nasu/spot-flowerworld',
  'nasu/spot-minamigaoka',
  'nasu/spot-highlandpark',
  'nasu/spot-rindolake',
  'nasu/spot-animalkingdom',
];
---

<PageHero eyebrow={p.eyebrow} title={p.h1} lead={p.lead} image="nasu/mountains-autumn" />
<Breadcrumbs lang={lang} t={t} trail={['hotel', 'nasu']} />

<section class="section">
  <div class="wrap-narrow stack">
    {p.introBody.map((x) => <p>{x}</p>)}
  </div>
</section>

<section class="section section--paper">
  <div class="wrap grid grid--2">
    <article class="card">
      <div class="card__media">
        <Picture name="nasu/jizo" sizes="(min-width: 860px) 46vw, 92vw" />
      </div>
      <div class="card__body">
        <p class="eyebrow">History</p>
        <h2 class="card__title">{p.historyHeading}</h2>
        <p class="card__text">{p.historyBody}</p>
      </div>
    </article>
    <article class="card">
      <div class="card__media">
        <Picture name="nasu/festival" sizes="(min-width: 860px) 46vw, 92vw" />
      </div>
      <div class="card__body">
        <p class="eyebrow">Culture</p>
        <h2 class="card__title">{p.cultureHeading}</h2>
        <p class="card__text">{p.cultureBody}</p>
      </div>
    </article>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">Around</p>
    <h2 class="section-title">{p.aroundHeading}</h2>
    <hr class="rule" />
    <p class="h-lead around__lead">{p.aroundLead}</p>

    <div class="grid grid--4 around">
      {
        p.around.map((c, i) => (
          <article class="card">
            <div class="card__media">
              <Picture
                name={aroundImages[i]}
                sizes="(min-width: 1000px) 24vw, (min-width: 640px) 46vw, 92vw"
              />
            </div>
            <div class="card__body">
              <h3 class="card__title around__title">{c.title}</h3>
              <p class="around__access">{c.access}</p>
              <p class="card__text">{c.body}</p>
            </div>
          </article>
        ))
      }
    </div>
    <p class="notes aroundMore"><span>{p.aroundMore}</span></p>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap split">
    <div class="split__text">
      <p class="eyebrow">Gourmet</p>
      <h2 class="section-title">{p.gourmetHeading}</h2>
      <hr class="rule" />
      <p>{p.gourmetBody}</p>
      <p class="callout">{p.note}</p>
      <p class="btn-row">
        <a class="btn btn--ghost" href={pathFor(lang, 'access')}>{t.nav.access}</a>
      </p>
    </div>
    <div class="grid grid--2 gourmetPics">
      <figure class="figure">
        <Picture name="nasu/spot-cheesegarden" sizes="(min-width: 860px) 23vw, 46vw" ratio="3/2" />
      </figure>
      <figure class="figure">
        <Picture name="nasu/spot-goodnews" sizes="(min-width: 860px) 23vw, 46vw" ratio="3/2" />
      </figure>
    </div>
  </div>
</section>

<style>
  .panel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .panel__title {
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }

  .panel__body {
    color: var(--ink-70);
    font-size: var(--step--1);
    line-height: 1.95;
  }

  .around__lead {
    margin-top: 1.5rem;
    max-width: 56ch;
  }

  .around {
    margin-top: 2.25rem;
  }

  .around__title {
    font-size: var(--step-1);
    word-break: auto-phrase;
  }

  /* 所要時間は見出しから切り出し、小さなラベルとして添える */
  .around__access {
    margin-top: 0.3rem;
    margin-bottom: 0.55rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--ai-700);
  }

  .around__access::before {
    content: '\2014\a0';
    color: var(--gold);
  }

  .aroundMore {
    margin-top: 1.75rem;
  }

  /* 分割レイアウトの中では auto-fit が 1 列に落ちるため 2 列を明示する */
  @media (min-width: 860px) {
    .gourmetPics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
