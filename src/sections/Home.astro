---
import Picture from '../components/Picture.astro';
import BookingRoutes from '../components/BookingRoutes.astro';
import { pathFor, HOTEL, HOTEL_ADDRESS_I18N, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';
import type { ImageName } from '../data/images.generated';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const p = t.pages.home;
const hotelAddress = HOTEL_ADDRESS_I18N[lang];

const highlightLinks: { key: Parameters<typeof pathFor>[1]; img: ImageName }[] = [
  { key: 'rooms', img: 'rooms/premium-suite-a' },
  { key: 'spa', img: 'spa/daiyokujo-wide' },
  { key: 'dining', img: 'dining/restaurant-raki' },
  { key: 'banquet', img: 'banquet/hall' },
  { key: 'salon', img: 'salon/kame-open' },
  { key: 'hotel', img: 'lobby/front-desk' },
];
---

<!-- ============ ヒーロー ============ -->
<section class="hero">
  <div class="hero__media">
    <Picture name="hotel/exterior-night" priority sizes="100vw" class="hero__img" alt="" />
  </div>
  <div class="wrap hero__inner">
    <p class="hero__eyebrow">{p.eyebrow}</p>
    <h1 class="hero__title">{p.heroTitle}</h1>
    <p class="hero__sub">{p.heroSub}</p>
    <p class="hero__where">{p.heroLocation}</p>
    <div class="btn-row hero__btns">
      <a class="btn btn--onDark" href={pathFor(lang, 'booking')}>{p.heroCtaPrimary}</a>
      <a class="btn btn--outlineDark" href={pathFor(lang, 'hotel')}>{p.heroCtaSecondary}</a>
    </div>
  </div>
</section>

<!-- ============ イントロ ============ -->
<section class="section">
  <div class="wrap split">
    <div class="split__text">
      <p class="eyebrow">About</p>
      <h2 class="section-title">{p.introHeading}</h2>
      <hr class="rule" />
      {p.introBody.map((para) => <p>{para}</p>)}
      <p class="btn-row">
        <a class="btn btn--ghost" href={pathFor(lang, 'hotel')}>{t.nav.hotel}</a>
      </p>
    </div>
    <figure class="figure">
      <Picture name="rooms/window-view" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<!-- ============ 施設概要 ============ -->
<section class="section section--paper section--tight">
  <div class="wrap">
    <h2 class="section-title">{p.factsHeading}</h2>
    <hr class="rule" />
    <dl class="dl facts">
      {
        p.facts.map(([k, v]) => (
          <div class="dl__row">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<!-- ============ 館内のご案内 ============ -->
<section class="section">
  <div class="wrap">
    <p class="eyebrow">Facilities</p>
    <h2 class="section-title">{p.highlightsHeading}</h2>
    <hr class="rule" />
    <p class="h-lead highlights__lead">{p.highlightsLead}</p>

    <div class="grid grid--3 highlights">
      {
        p.highlights.map((card, i) => (
          <article class="card card--link">
            <div class="card__media">
              <Picture
                name={highlightLinks[i].img}
                sizes="(min-width: 1000px) 33vw, (min-width: 640px) 48vw, 92vw"
              />
            </div>
            <div class="card__body">
              <h3 class="card__title">
                <a class="stretch" href={pathFor(lang, highlightLinks[i].key)}>{card.title}</a>
              </h3>
              <p class="card__text">{card.body}</p>
              <p class="card__link">{t.ui.readMore} →</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- ============ コンシェルジュ ============ -->
<section class="section section--ai">
  <div class="wrap split">
    <figure class="figure">
      <Picture name="lobby/lounge" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
    <div class="split__text">
      <p class="eyebrow">Service</p>
      <h2 class="section-title">{p.conciergeHeading}</h2>
      <hr class="rule" />
      <p>{p.conciergeBody}</p>
    </div>
  </div>
</section>

<!-- ============ 予約導線 ============ -->
<section class="section section--paper" id="booking">
  <div class="wrap">
    <p class="eyebrow">Reservation</p>
    <h2 class="section-title">{p.bookingHeading}</h2>
    <hr class="rule" />
    <p class="h-lead booking__lead">{p.bookingLead}</p>
    <BookingRoutes lang={lang} t={t} level={3} />
  </div>
</section>

<!-- ============ 那須高原 ============ -->
<section class="section">
  <div class="wrap split split--reverse">
    <div class="split__text">
      <p class="eyebrow">Nasu Highland</p>
      <h2 class="section-title">{p.nasuHeading}</h2>
      <hr class="rule" />
      <p>{p.nasuBody}</p>
      <p class="btn-row">
        <a class="btn btn--ghost" href={pathFor(lang, 'nasu')}>{p.nasuCta}</a>
      </p>
    </div>
    <figure class="figure">
      <Picture name="nasu/mountains-autumn" sizes="(min-width: 860px) 46vw, 92vw" ratio="4/3" />
    </figure>
  </div>
</section>

<!-- ============ 会員権 ＋ アクセス ============ -->
<section class="section section--paper">
  <div class="wrap grid grid--2">
    <article class="panel">
      <p class="eyebrow">Membership</p>
      <h2 class="panel__title">{p.membershipHeading}</h2>
      <p class="panel__body">{p.membershipBody}</p>
      <p class="btn-row">
        <a class="btn btn--ghost" href={pathFor(lang, 'membership')}>{p.membershipCta}</a>
      </p>
    </article>

    <article class="panel">
      <p class="eyebrow">Access</p>
      <h2 class="panel__title">{p.accessHeading}</h2>
      <p class="panel__body">{p.accessLead}</p>
      <address class="panel__addr">
        〒{HOTEL.postal} {hotelAddress}<br />
        <a href={`tel:${HOTEL.telHref}`}>TEL {HOTEL.tel}</a>
        <span class="panel__hours">（{t.ui.telHoursLabel} {HOTEL.telHours}）</span>
      </address>
      <p class="btn-row">
        <a class="btn btn--ghost" href={pathFor(lang, 'access')}>{p.accessCta}</a>
        <a class="btn btn--ghost ext" href={HOTEL.mapUrl} target="_blank" rel="noopener">
          {t.pages.access.mapCta}
        </a>
      </p>
    </article>
  </div>
</section>

<style>
  /* ---------------- ヒーロー ---------------- */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--ai-900);
    color: #fff;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 720px);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 写真の明るい部分でも文字が読めるよう、縦グラデーションに
     左からの暗がりを重ねる（写真を潰しすぎない二層構成）。 */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(4, 20, 33, 0.72) 0%,
        rgba(4, 20, 33, 0.42) 42%,
        rgba(4, 20, 33, 0.12) 75%
      ),
      linear-gradient(
        to bottom,
        rgba(4, 20, 33, 0.38) 0%,
        rgba(4, 20, 33, 0.2) 40%,
        rgba(4, 20, 33, 0.72) 100%
      );
  }

  .hero__inner {
    padding-block: clamp(4rem, 14vw, 8rem) clamp(2.5rem, 7vw, 4.5rem);
  }

  .hero__eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #e5c778;
    margin: 0 0 1rem;
    font-weight: 700;
    text-shadow: 0 1px 10px rgba(0, 12, 22, 0.8);
  }

  .hero__title {
    font-size: var(--step-5);
    color: #fff;
    max-width: 18ch;
    line-height: 1.3;
    text-shadow: 0 2px 20px rgba(0, 15, 28, 0.5);
  }

  .hero__sub {
    margin-top: 1.25rem;
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.95;
    color: #e8eef3;
    text-shadow: 0 1px 14px rgba(0, 15, 28, 0.5);
  }

  .hero__where {
    margin-top: 1rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: #c3d4e0;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    display: inline-block;
  }

  .hero__btns {
    margin-top: 1.75rem;
  }

  @media (max-width: 520px) {
    .hero__eyebrow {
      letter-spacing: 0.14em;
      font-size: 0.6875rem;
    }
  }

  /* ---------------- その他 ---------------- */
  .facts {
    margin-top: 1.75rem;
    max-width: 46rem;
  }

  .highlights__lead,
  .booking__lead {
    margin-top: 1.5rem;
    max-width: 52ch;
  }

  .highlights {
    margin-top: 2.25rem;
  }

  .highlights .card__title a {
    text-decoration: none;
    color: inherit;
  }

  .highlights .card--link:hover .card__title a {
    color: var(--ai-700);
  }

  .panel {
    background: var(--white);
    border: 1px solid var(--line-soft);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .panel__title {
    font-size: var(--step-2);
  }

  .panel__body {
    color: var(--ink-70);
    font-size: var(--step--1);
    line-height: 1.95;
    flex: 1;
  }

  .panel__addr {
    font-style: normal;
    font-size: var(--step--1);
    line-height: 1.9;
    padding: 0.9rem 1rem;
    background: var(--paper-2);
  }

  .panel__addr a {
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
    min-height: 32px;
  }

  .panel__addr a:hover {
    text-decoration: underline;
  }

  .panel__hours {
    color: var(--ink-50);
    font-size: 0.75rem;
  }
</style>
