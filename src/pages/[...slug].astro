---
/**
 * 全ページ（4言語 × 12ページ = 48 URL）をここから静的生成する。
 * 日本語はプレフィックスなし（/、/raki-house/ …）、
 * 他言語は /en/…、/zh/…、/vi/… に出力される。
 */
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';

import Home from '../sections/Home.astro';
import Hotel from '../sections/Hotel.astro';
import Rooms from '../sections/Rooms.astro';
import Spa from '../sections/Spa.astro';
import Dining from '../sections/Dining.astro';
import Banquet from '../sections/Banquet.astro';
import Salon from '../sections/Salon.astro';
import Nasu from '../sections/Nasu.astro';
import Booking from '../sections/Booking.astro';
import Membership from '../sections/Membership.astro';
import Access from '../sections/Access.astro';
import Company from '../sections/Company.astro';

import { LANGS, ROUTE_KEYS, ROUTES, type Lang, type RouteKey } from '../data/site';
import { getDict } from '../i18n';
import { organization, lodgingBusiness, webSite, breadcrumbs } from '../data/jsonld';
import type { ImageName } from '../data/images.generated';

export function getStaticPaths() {
  const paths: { params: { slug: string | undefined }; props: { lang: Lang; route: RouteKey } }[] = [];
  for (const lang of LANGS) {
    for (const route of ROUTE_KEYS) {
      const tail = ROUTES[route].replace(/\/$/, '');
      const prefix = lang === 'ja' ? '' : lang;
      const slug = [prefix, tail].filter(Boolean).join('/');
      paths.push({ params: { slug: slug || undefined }, props: { lang, route } });
    }
  }
  return paths;
}

const { lang, route } = Astro.props;
const t = getDict(lang);
const page = t.pages[route as keyof typeof t.pages];

const SECTION = {
  home: Home,
  hotel: Hotel,
  rooms: Rooms,
  spa: Spa,
  dining: Dining,
  banquet: Banquet,
  salon: Salon,
  nasu: Nasu,
  booking: Booking,
  membership: Membership,
  access: Access,
  company: Company,
} as const;

const Section = SECTION[route];

/** ページごとの OGP 画像と LCP 画像 */
const OG: Record<RouteKey, ImageName> = {
  home: 'hotel/exterior-night',
  hotel: 'hotel/entrance',
  rooms: 'rooms/window-view',
  spa: 'spa/daiyokujo-wide',
  dining: 'dining/restaurant-raki',
  banquet: 'banquet/hall',
  salon: 'salon/kame-room',
  nasu: 'nasu/mountains-autumn',
  booking: 'hotel/reception',
  membership: 'rooms/living',
  access: 'hotel/exterior',
  company: 'lobby/atrium',
};

/** パンくずの JSON-LD 用の経路 */
const TRAIL: Record<RouteKey, RouteKey[]> = {
  home: [],
  hotel: ['hotel'],
  rooms: ['hotel', 'rooms'],
  spa: ['hotel', 'spa'],
  dining: ['hotel', 'dining'],
  banquet: ['hotel', 'banquet'],
  salon: ['hotel', 'salon'],
  nasu: ['hotel', 'nasu'],
  booking: ['booking'],
  membership: ['membership'],
  access: ['access'],
  company: ['company'],
};

const jsonLd: unknown[] = [webSite(lang), organization()];
if (route === 'home' || route === 'hotel' || route === 'access') {
  jsonLd.push(lodgingBusiness());
}
if (TRAIL[route].length) {
  jsonLd.push(
    breadcrumbs(lang, [
      { key: 'home', name: t.ui.breadcrumbHome },
      ...TRAIL[route].map((k) => ({ key: k, name: t.nav[k] })),
    ]),
  );
}
---

<Base
  lang={lang}
  route={route}
  title={page.title}
  description={page.description}
  ogImage={OG[route]}
  preloadImage={{ name: OG[route], sizes: '100vw' }}
  jsonLd={jsonLd}
>
  <Section lang={lang} t={t} />
  {route !== 'booking' && <CtaBand lang={lang} t={t} />}
</Base>
