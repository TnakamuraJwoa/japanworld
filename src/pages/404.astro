---
/**
 * 404。worker/index.ts が未知のパスに対してこのページを返す。
 */
import Base from '../layouts/Base.astro';
import { pathFor, ROUTE_LABEL } from '../data/site';
import { BUSINESSES } from '../data/business';
---

<Base
  title="ページが見つかりません"
  description="お探しのページは移動または削除された可能性があります。"
  path="/404/"
  noindex
>
  <section class="section notfound">
    <div class="wrap-narrow">
      <p class="notfound__code" aria-hidden="true">404</p>
      <h1 class="notfound__title">ページが見つかりません</h1>
      <p class="notfound__body">
        お探しのページは、移動または削除された可能性があります。<br />
        お手数ですが、下記のリンクからお探しください。
      </p>

      <ul class="notfound__links">
        <li><a class="link-arrow" href={pathFor('home')}>トップページ</a></li>
        <li><a class="link-arrow" href={pathFor('business')}>{ROUTE_LABEL.business}</a></li>
        {
          BUSINESSES.map((b) => (
            <li>
              <a class="link-arrow" href={pathFor(b.key)}>
                {b.title}
              </a>
            </li>
          ))
        }
        <li><a class="link-arrow" href={pathFor('company')}>{ROUTE_LABEL.company}</a></li>
        <li><a class="link-arrow" href={pathFor('news')}>{ROUTE_LABEL.news}</a></li>
        <li><a class="link-arrow" href={pathFor('contact')}>{ROUTE_LABEL.contact}</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding-block: clamp(4rem, 12vw, 9rem);
  }

  .notfound__code {
    font-family: var(--serif);
    font-size: clamp(3rem, 10vw, 5rem);
    line-height: 1;
    color: var(--paper-3);
    letter-spacing: 0.06em;
    margin-bottom: 1.5rem;
  }

  .notfound__title {
    font-size: var(--step-3);
  }

  .notfound__body {
    margin-top: 1.5rem;
    line-height: 2.05;
    color: var(--ink-70);
  }

  .notfound__links {
    list-style: none;
    padding: 0;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
  }

  .notfound__links a {
    min-height: 48px;
    display: inline-flex;
  }
</style>
