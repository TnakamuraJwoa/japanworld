---
/**
 * 下層ページ共通の見出し。
 *
 * 画像を渡したときだけ帯状のビジュアルを敷く。
 * 画像がないページ（会社情報・お問い合わせなど）は文字だけの静かな見出しになる。
 */
import Picture from './Picture.astro';
import type { ImageName } from '../data/images.generated';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageName;
  /** LCP になる場合に true */
  priority?: boolean;
}
const { eyebrow, title, lead, image, priority = false } = Astro.props;
---

{
  image ? (
    <section class="pagehero pagehero--media">
      <div class="pagehero__media zoom-out">
        <Picture name={image} alt="" sizes="100vw" priority={priority} class="pagehero__img" />
      </div>
      <div class="wrap pagehero__inner">
        <p class="pagehero__eyebrow">{eyebrow}</p>
        <h1 class="pagehero__title">{title}</h1>
        {lead && <p class="pagehero__lead">{lead}</p>}
      </div>
    </section>
  ) : (
    <section class="pagehero">
      <div class="wrap pagehero__inner">
        <p class="pagehero__eyebrow">{eyebrow}</p>
        <h1 class="pagehero__title">{title}</h1>
        {lead && <p class="pagehero__lead">{lead}</p>}
      </div>
    </section>
  )
}

<style>
  .pagehero {
    background: var(--paper-2);
    border-bottom: 1px solid var(--line-soft);
  }

  .pagehero__inner {
    padding-block: clamp(2.75rem, 7vw, 5rem);
  }

  .pagehero__eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ai-600);
    font-weight: 600;
    margin-bottom: 0.9rem;
  }

  .pagehero__title {
    font-size: var(--step-4);
    line-height: 1.35;
  }

  .pagehero__lead {
    margin-top: 1.25rem;
    font-size: var(--step-1);
    line-height: 1.9;
    color: var(--ink-70);
    max-width: 42em;
  }

  /* ---- 画像つき ---- */
  .pagehero--media {
    position: relative;
    background: var(--ai-900);
    border-bottom: 0;
    isolation: isolate;
    /* ズームアウト演出で画像が 1.08 倍から始まるため、
       はみ出した分を必ず切り落とす（横スクロール防止） */
    overflow: hidden;
  }

  .pagehero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .pagehero__media :global(.pagehero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 文字を読ませるための覆い。画像の明るさに関わらず十分な
     コントラスト比（4.5:1 以上）を確保するために濃いめに敷く。 */
  .pagehero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(4, 26, 41, 0.84) 0%,
      rgba(4, 26, 41, 0.66) 55%,
      rgba(4, 26, 41, 0.48) 100%
    );
  }

  .pagehero--media .pagehero__inner {
    padding-block: clamp(3.5rem, 10vw, 7rem);
  }

  .pagehero--media .pagehero__eyebrow {
    color: var(--gold-soft);
  }

  .pagehero--media .pagehero__title {
    color: #fff;
  }

  .pagehero--media .pagehero__lead {
    color: #e2eaf0;
  }
</style>
