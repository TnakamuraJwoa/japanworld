---
/**
 * サイト共通のフッター。
 *
 * 関連サイトはいずれも別ドメインで動いている実在のサービス。
 * JW NFT Platform は FEATURES.nftLink で出し分けている（証明書失効時に一括で伏せるため）。
 *
 * ⚠ 運営会社の明記は、サイト全体でこのフッター1箇所に集約している。
 *   細胞浴SALON「太古の甕」と Esthetic Salon RICHIA は JWORLD CO.,LTD の事業で、
 *   Japan World株式会社の直接事業ではないため、ここで運営会社を示す。
 *   各ページの本文では運営会社をいちいち断らない（「当社が運営する」と書かないだけ）。
 */
import { SITE, COMPANY, HOTEL, EXTERNAL, FEATURES, pathFor, ROUTE_LABEL } from '../data/site';
import { BUSINESSES, operatorName } from '../data/business';

const year = new Date().getFullYear();
const copyright =
  year > SITE.copyrightYear ? `${SITE.copyrightYear}–${year}` : String(SITE.copyrightYear);

const related = [
  {
    label: '楽気ハウス那須 ホテル公式サイト',
    note: '施設のご紹介・宿泊のご予約',
    href: EXTERNAL.hotelSite,
  },
  {
    label: 'JWCCS 会員専用予約',
    note: '楽気ハウス会員の方のご予約',
    href: EXTERNAL.members,
  },
  {
    label: '細胞浴SALON 太古の甕 公式サイト',
    note: '運営: JWORLD CO.,LTD（ジェイワールド株式会社）',
    href: EXTERNAL.saibouyoku,
  },
  ...(FEATURES.nftLink
    ? [{ label: 'JW NFT Platform', note: '楽気ハウスNFT宿泊券', href: EXTERNAL.nft }]
    : []),
];
---

<footer class="site-footer">
  <div class="wrap site-footer__main">
    <div class="site-footer__brand">
      <p class="site-footer__name">{COMPANY.name}</p>
      <p class="site-footer__tagline">{SITE.tagline}</p>
      <address class="site-footer__address">
        〒{COMPANY.postal}<br />
        {COMPANY.addressFull}<br />
        TEL <a href={`tel:${COMPANY.telHref}`}>{COMPANY.tel}</a><br />
        <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
      </address>
    </div>

    <nav class="site-footer__nav" aria-label="フッターナビゲーション">
      <div class="site-footer__col">
        <p class="site-footer__heading">
          <a href={pathFor('business')}>{ROUTE_LABEL.business}</a>
        </p>
        <ul>
          {
            BUSINESSES.map((b) => (
              <li>
                <a href={pathFor(b.key)}>{b.title}</a>
                {/* 当社が運営している事業には付けない（自社サイトなので自明） */}
                {b.operator !== 'japanworld' && (
                  <span class="site-footer__note">運営: {operatorName(b)}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__heading">
          <a href={pathFor('company')}>{ROUTE_LABEL.company}</a>
        </p>
        <ul>
          <li><a href={pathFor('news')}>{ROUTE_LABEL.news}</a></li>
          <li><a href={pathFor('contact')}>{ROUTE_LABEL.contact}</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <p class="site-footer__heading">関連サイト</p>
        <ul>
          {
            related.map((r) => (
              <li>
                <a class="ext" href={r.href} target="_blank" rel="noopener">
                  {r.label}
                </a>
                <span class="site-footer__note">{r.note}</span>
              </li>
            ))
          }
        </ul>
        <p class="site-footer__note site-footer__note--block">
          別サイトが新しいタブで開きます。
        </p>
      </div>
    </nav>
  </div>

  <div class="wrap site-footer__hotel">
    <p>
      <strong>{HOTEL.name}</strong>　{HOTEL.addressFull}　TEL{' '}
      <a href={`tel:${HOTEL.telHref}`}>{HOTEL.tel}</a>（受付 {HOTEL.telHours}）
    </p>
  </div>

  <div class="site-footer__bar">
    <div class="wrap site-footer__barInner">
      <p class="small">© {copyright} {COMPANY.name}</p>
      <p><a class="link-arrow" href="#top">ページの先頭へ</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ai-900);
    color: #d7e2ea;
    margin-top: auto;
  }

  .site-footer a {
    color: #d7e2ea;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer__main {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4rem);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  @media (min-width: 900px) {
    .site-footer__main {
      grid-template-columns: minmax(16rem, 1fr) 2fr;
    }
  }

  .site-footer__name {
    font-family: var(--serif);
    font-size: var(--step-1);
    letter-spacing: 0.06em;
    color: #fff;
  }

  .site-footer__tagline {
    font-size: var(--step--1);
    color: var(--gold-soft);
    letter-spacing: 0.08em;
    margin-top: 0.5rem;
  }

  .site-footer__address {
    font-style: normal;
    font-size: var(--step--1);
    line-height: 2;
    margin-top: 1.5rem;
    color: #b9c9d6;
  }

  .site-footer__nav {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  @media (min-width: 560px) {
    .site-footer__nav {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    }
  }

  .site-footer__heading {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: #fff;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .site-footer__heading a {
    color: #fff;
  }

  .site-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: grid;
  }

  .site-footer__col li {
    display: grid;
  }

  .site-footer__col li > a {
    font-size: var(--step--1);
    line-height: 1.6;
    padding-block: 0.7rem;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .site-footer__note {
    font-size: 0.75rem;
    color: #93a7b7;
    margin-top: -0.5rem;
    padding-bottom: 0.4rem;
    line-height: 1.6;
  }

  .site-footer__note--block {
    margin-top: 0.9rem;
    padding-bottom: 0;
  }

  .site-footer__hotel {
    padding-block: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--step--1);
    line-height: 1.9;
    color: #b9c9d6;
  }

  .site-footer__hotel strong {
    color: #fff;
    font-weight: 600;
  }

  .site-footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .site-footer__barInner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
  }

  .site-footer__barInner .link-arrow {
    color: #d7e2ea;
    min-height: 44px;
    align-items: center;
  }
</style>
