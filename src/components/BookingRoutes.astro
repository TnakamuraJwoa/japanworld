---
/**
 * 予約導線のカード。トップ・宿泊予約ページの両方で使う。
 *
 * 現行サイトはヘッダーに NFT、フッターに会員予約のリンクがあるだけで、
 * 一般のお客様がどこから予約するのかが示されていなかった。
 *
 * NFT宿泊券のカードは FEATURES.nftLink で出し分けている。
 * 現在は nft.japanworld.co.jp の TLS 証明書失効のため非表示（src/data/site.ts 参照）。
 */
import { EXTERNAL, FEATURES, HOTEL, bookingUrl, pathFor, type Lang } from '../data/site';
import type { Dict } from '../i18n/types';

interface Props {
  lang: Lang;
  t: Dict;
  /** 見出しレベル */
  level?: 2 | 3;
}
const { lang, t, level = 2 } = Astro.props;

const HH = `h${level + 1}` as 'h3' | 'h4';

const showNft = FEATURES.nftLink;
---

<div class:list={['routes', !showNft && 'routes--pair']}>
  <article class="route route--primary">
    <p class="route__tag">01</p>
    <HH class="route__title">{t.booking.generalTitle}</HH>
    <p class="route__body">{t.booking.generalBody}</p>
    <a class="btn btn--primary ext" href={bookingUrl(lang)} target="_blank" rel="noopener">
      {t.booking.generalCta}
    </a>
    <p class="route__tel">
      <a href={`tel:${HOTEL.telHref}`}>TEL {HOTEL.tel}</a>
      <span>{t.ui.telHoursLabel} {HOTEL.telHours}</span>
    </p>
  </article>

  <article class="route">
    <p class="route__tag">02</p>
    <HH class="route__title">{t.booking.membersTitle}</HH>
    <p class="route__body">{t.booking.membersBody}</p>
    <a class="btn btn--ghost ext" href={EXTERNAL.members} target="_blank" rel="noopener">
      {t.booking.membersCta}
    </a>
    <p class="route__more">
      <a href={pathFor(lang, 'membership')}>{t.nav.membership}</a>
    </p>
  </article>

  {
    showNft && (
      <article class="route">
        <p class="route__tag">03</p>
        <HH class="route__title">{t.booking.nftTitle}</HH>
        <p class="route__body">{t.booking.nftBody}</p>
        <a class="btn btn--ghost ext" href={EXTERNAL.nft} target="_blank" rel="noopener">
          {t.booking.nftCta}
        </a>
        <p class="route__tel">
          <a href={`tel:${HOTEL.telHref}`}>TEL {HOTEL.tel}</a>
        </p>
      </article>
    )
  }
</div>

<style>
  .routes {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  /* カードが 2 枚のときは、3 枚分の幅いっぱいに引き伸ばさず
     中央寄せの 2 カラムに収める（間延びを防ぐ）。 */
  .routes--pair {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    max-width: 58rem;
    margin-inline: auto;
  }

  .route {
    background: var(--white);
    border: 1px solid var(--line-soft);
    border-top: 3px solid var(--line);
    padding: clamp(1.4rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .route--primary {
    border-top-color: var(--ai-700);
    box-shadow: var(--shadow);
  }

  .route__tag {
    font-family: var(--serif);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    color: var(--gold);
    margin: 0;
  }

  .route__title {
    font-size: var(--step-2);
    margin: 0;
  }

  .route__body {
    font-size: var(--step--1);
    color: var(--ink-70);
    line-height: 1.95;
    flex: 1;
  }

  .route .btn {
    align-self: flex-start;
  }

  .route__tel,
  .route__more {
    margin: 0;
    font-size: var(--step--1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    align-items: baseline;
  }

  .route__tel a {
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    display: inline-block;
    min-height: 32px;
  }

  .route__tel a:hover {
    text-decoration: underline;
  }

  .route__tel span {
    color: var(--ink-50);
    font-size: 0.75rem;
  }
</style>
