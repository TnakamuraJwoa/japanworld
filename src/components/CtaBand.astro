---
/**
 * 下層ページの末尾に置く問い合わせ導線。
 */
import { COMPANY, pathFor } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'お問い合わせ',
  body = '事業・サービスに関するご相談、取材のお申し込みなど、お気軽にご連絡ください。',
} = Astro.props;
---

<section class="band">
  <div class="wrap band__inner">
    <h2 class="section-title">{heading}</h2>
    <p class="band__body">{body}</p>
    <div class="btn-row">
      <a class="btn btn--onDark" href={pathFor('contact')}>お問い合わせページへ</a>
      <a class="btn btn--outlineDark" href={`tel:${COMPANY.telHref}`}>
        TEL {COMPANY.tel}
      </a>
    </div>
  </div>
</section>

<style>
  .band__body {
    max-width: 38em;
    line-height: 2;
    color: #cfdde7;
  }
</style>
