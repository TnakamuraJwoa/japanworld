---
import { pathFor, ROUTE_LABEL, type RouteKey } from '../data/site';

export type Crumb = { name: string; href?: string };

interface Props {
  /** ホームを除いた経路。RouteKey でも、任意の名前＋リンクでも渡せる */
  trail: (RouteKey | Crumb)[];
}
const { trail } = Astro.props;

const items: Crumb[] = trail.map((c) =>
  typeof c === 'string' ? { name: ROUTE_LABEL[c], href: pathFor(c) } : c,
);
---

<nav class="crumbs wrap" aria-label="パンくずリスト">
  <ol>
    <li><a href={pathFor('home')}>ホーム</a></li>
    {
      items.map((item, i) =>
        i === items.length - 1 || !item.href ? (
          <li aria-current="page">{item.name}</li>
        ) : (
          <li>
            <a href={item.href}>{item.name}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
