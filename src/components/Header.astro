---
/**
 * サイト共通のヘッダー。
 *
 * - グローバルナビ（事業紹介 / 会社情報 / お知らせ / お問い合わせ）
 * - 事業紹介の配下では、第2段に事業サブナビを出す
 * - スマートフォンではハンバーガーで開閉するドロワー
 *
 * 言語切替は廃止（日本語単独サイト）。
 */
import { pathFor, MAIN_NAV, BUSINESS_SECTION, ROUTE_LABEL, type RouteKey } from '../data/site';

interface Props {
  /** 表示中のページの絶対パス（例 /business/wellness/） */
  path: string;
}
const { path } = Astro.props;

const businessRoot = pathFor('business');
const inBusiness = path.startsWith(businessRoot);

/** そのナビ項目が「現在地」か。配下ページでも親を現在地として扱う */
function isCurrent(key: RouteKey): boolean {
  const href = pathFor(key);
  if (key === 'home') return path === '/';
  if (key === 'business') return inBusiness;
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href={pathFor('home')}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 64 40" width="38" height="24" focusable="false">
          <path
            d="M2 6 L16 34 L32 12 L48 34 L62 6"
            fill="none"
            stroke="currentColor"
            stroke-width="7"
            stroke-linejoin="miter"></path>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">Japan World</span>
        <span class="brand__sub">Japan World株式会社</span>
      </span>
    </a>

    <button
      class="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="navToggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="navToggle__label">メニュー</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="グローバルナビゲーション" data-nav>
      <ul class="site-nav__list">
        {
          MAIN_NAV.map((key) => (
            <li>
              <a href={pathFor(key)} aria-current={isCurrent(key) ? 'page' : undefined}>
                {ROUTE_LABEL[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {
    inBusiness && (
      <nav class="subnav" aria-label="事業紹介">
        <div class="wrap subnav__inner scroll-x">
          <ul>
            {BUSINESS_SECTION.map((key) => (
              <li>
                <a
                  href={pathFor(key)}
                  aria-current={path === pathFor(key) ? 'page' : undefined}
                >
                  {key === 'business' ? '事業紹介トップ' : ROUTE_LABEL[key]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    border-bottom: 1px solid var(--line-soft);
    backdrop-filter: saturate(140%) blur(8px);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  @media (min-width: 1000px) {
    .site-header__bar {
      min-height: 76px;
    }
  }

  /* ---------------- ブランド ---------------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ai-900);
    padding-block: 0.5rem;
  }

  .brand__mark {
    color: var(--ai-700);
    display: block;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand__name {
    font-family: var(--serif);
    font-size: 1.0625rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .brand__sub {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-50);
    margin-top: 0.2em;
  }

  /* ---------------- ハンバーガー ---------------- */
  .navToggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    min-width: 48px;
    padding: 0 0.35rem;
    background: none;
    border: 0;
    color: var(--ai-900);
    font: inherit;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    cursor: pointer;
  }

  .navToggle__bars {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .navToggle__bars span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.22s ease, opacity 0.18s ease;
  }

  .navToggle[aria-expanded='true'] .navToggle__bars span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .navToggle[aria-expanded='true'] .navToggle__bars span:nth-child(2) {
    opacity: 0;
  }

  .navToggle[aria-expanded='true'] .navToggle__bars span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .navToggle__bars span {
      transition: none;
    }
  }

  /* ---------------- ナビ（スマートフォン） ---------------- */
  .site-nav {
    position: fixed;
    inset: 64px 0 0;
    background: var(--paper);
    padding: 1.5rem var(--gutter) 3rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: none;
  }

  .site-nav[data-open] {
    display: block;
  }

  .site-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: 60px;
    padding-inline: 0.25rem;
    border-bottom: 1px solid var(--line-soft);
    text-decoration: none;
    color: var(--ai-900);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--ai-600);
  }

  .site-nav__list a[aria-current='page']::after {
    content: '';
    margin-inline-start: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* ---------------- ナビ（PC） ---------------- */
  @media (min-width: 1000px) {
    .navToggle {
      display: none;
    }

    .site-nav {
      position: static;
      display: block;
      background: none;
      padding: 0;
      overflow: visible;
      inset: auto;
    }

    .site-nav__list {
      grid-auto-flow: column;
      gap: 0.35rem;
      align-items: center;
    }

    .site-nav__list a {
      min-height: 44px;
      border: 0;
      font-size: 0.9375rem;
      padding-inline: 1rem;
      position: relative;
      letter-spacing: 0.06em;
    }

    .site-nav__list a::before {
      content: '';
      position: absolute;
      left: 1rem;
      right: 1rem;
      bottom: 0.55rem;
      height: 1px;
      background: var(--gold);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.24s ease;
    }

    .site-nav__list a:hover::before,
    .site-nav__list a[aria-current='page']::before {
      transform: scaleX(1);
    }

    .site-nav__list a[aria-current='page']::after {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .site-nav__list a::before {
        transition: none;
      }
    }
  }

  /* ---------------- 第2段ナビ ---------------- */
  .subnav {
    border-top: 1px solid var(--line-soft);
    background: var(--white);
  }

  .subnav__inner ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .subnav__inner a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 0.9rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-70);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    border-bottom: 2px solid transparent;
  }

  .subnav__inner a:hover {
    color: var(--ai-700);
  }

  .subnav__inner a[aria-current='page'] {
    color: var(--ai-800);
    font-weight: 600;
    border-bottom-color: var(--gold);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        nav.setAttribute('data-open', '');
        document.body.style.overflow = 'hidden';
      } else {
        nav.removeAttribute('data-open');
        document.body.style.overflow = '';
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // デスクトップ幅へ戻したときに開閉状態をリセットする
    const mq = window.matchMedia('(min-width: 1000px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
