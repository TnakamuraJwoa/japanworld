---
/**
 * サイト共通のヘッダー。
 *
 * - グローバルナビ（事業紹介 / 会社情報 / お知らせ / お問い合わせ）
 * - 事業紹介の配下では、第2段に事業サブナビを出す
 * - スマートフォンではハンバーガーで開閉するドロワー
 *
 * 言語切替は廃止（日本語単独サイト）。
 */
import { pathFor, MAIN_NAV, BUSINESS_SECTION, ROUTE_LABEL, COMPANY, type RouteKey } from '../data/site';

interface Props {
  /** 表示中のページの絶対パス（例 /business/wellness/） */
  path: string;
}
const { path } = Astro.props;

const businessRoot = pathFor('business');
const inBusiness = path.startsWith(businessRoot);

/** そのナビ項目が「現在いる区画」か。配下ページでも親を現在地として扱う */
function inSection(key: RouteKey): boolean {
  const href = pathFor(key);
  if (key === 'home') return path === '/';
  if (key === 'business') return inBusiness;
  return path === href || path.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="brand" href={pathFor('home')}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 64 40" width="38" height="24" focusable="false">
          <path
            d="M2 6 L16 34 L32 12 L48 34 L62 6"
            fill="none"
            stroke="currentColor"
            stroke-width="7"
            stroke-linejoin="miter"></path>
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">Japan World</span>
        <span class="brand__sub">Japan World株式会社</span>
      </span>
    </a>

    <button
      class="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="navToggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="navToggle__label">メニュー</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="グローバルナビゲーション" data-nav>
      <ul class="site-nav__list">
        {
          MAIN_NAV.map((key) => (
            <li>
              {/* aria-current="page" はページと完全一致するリンクだけに付ける。
                  区画の強調は data-section で行う（下層ページや事業の子リンクと二重にならないように） */}
              <a
                href={pathFor(key)}
                aria-current={path === pathFor(key) ? 'page' : undefined}
                data-section={inSection(key) ? '' : undefined}
              >
                {ROUTE_LABEL[key]}
              </a>
              {/* 事業ページ以外では第2段ナビが出ないため、ドロワー内に事業の一覧を持たせる */}
              {key === 'business' && (
                <ul class="site-nav__sub">
                  {BUSINESS_SECTION.filter((k) => k !== 'business').map((k) => (
                    <li>
                      <a href={pathFor(k)} aria-current={path === pathFor(k) ? 'page' : undefined}>
                        {ROUTE_LABEL[k]}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>

      <a class="site-nav__tel" href={`tel:${COMPANY.telHref}`}>
        <span class="site-nav__telLabel">お電話でのお問い合わせ</span>
        <span class="site-nav__telNum">TEL {COMPANY.tel}</span>
      </a>
    </nav>
  </div>

  {
    inBusiness && (
      <nav class="subnav" aria-label="事業紹介">
        <div class="wrap subnav__inner scroll-x">
          <ul>
            {BUSINESS_SECTION.map((key) => (
              <li>
                <a
                  href={pathFor(key)}
                  aria-current={path === pathFor(key) ? 'page' : undefined}
                >
                  {key === 'business' ? '事業紹介トップ' : ROUTE_LABEL[key]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )
  }
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--line-soft);
  }

  /* 背景のぼかしは疑似要素に持たせる。
     backdrop-filter を .site-header 自身に掛けると、
     ヘッダーが position:fixed の子孫（スマホのドロワー）の
     配置基準になってしまい、ドロワーがヘッダーの高さに潰れる。 */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  @media (min-width: 1000px) {
    .site-header__bar {
      min-height: 76px;
    }
  }

  /* ---------------- ブランド ---------------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ai-900);
    padding-block: 0.5rem;
  }

  .brand__mark {
    color: var(--ai-700);
    display: block;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand__name {
    font-family: var(--serif);
    font-size: 1.0625rem;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .brand__sub {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-50);
    margin-top: 0.2em;
  }

  /* ---------------- ハンバーガー ---------------- */
  .navToggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    min-width: 48px;
    padding: 0 0.35rem;
    background: none;
    border: 0;
    color: var(--ai-900);
    font: inherit;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    cursor: pointer;
  }

  .navToggle__bars {
    display: grid;
    gap: 5px;
    width: 22px;
  }

  .navToggle__bars span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.22s ease, opacity 0.18s ease;
  }

  .navToggle[aria-expanded='true'] .navToggle__bars span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .navToggle[aria-expanded='true'] .navToggle__bars span:nth-child(2) {
    opacity: 0;
  }

  .navToggle[aria-expanded='true'] .navToggle__bars span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .navToggle__bars span {
      transition: none;
    }
  }

  /* ---------------- ナビ（スマートフォン） ---------------- */
  /* ヘッダーの実寸は JavaScript が --header-h に入れる。
     事業ページのように2段になる場合でも、その下から画面下端までを覆う。 */
  .site-nav {
    position: fixed;
    top: var(--header-h, 64px);
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--paper);
    padding: 1.25rem var(--gutter) 3rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition: opacity 0.2s ease, transform 0.24s ease, visibility 0.24s;
  }

  .site-nav[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  .site-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }

  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: 60px;
    padding-inline: 0.25rem;
    border-bottom: 1px solid var(--line-soft);
    text-decoration: none;
    color: var(--ai-900);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .site-nav__list a[aria-current='page'],
  .site-nav__list a[data-section] {
    color: var(--ai-600);
  }

  .site-nav__list a[aria-current='page']::after {
    content: '';
    margin-inline-start: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }

  .site-nav__sub {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1rem;
  }

  .site-nav__sub a {
    min-height: 52px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-70);
  }

  .site-nav__sub a::before {
    content: '';
    width: 0.75rem;
    height: 1px;
    margin-inline-end: 0.6em;
    background: var(--line);
  }

  .site-nav__tel {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 1.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-soft);
    border-radius: 2px;
    text-decoration: none;
    color: var(--ai-900);
  }

  .site-nav__telLabel {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-50);
  }

  .site-nav__telNum {
    font-family: var(--serif);
    font-size: 1.125rem;
    letter-spacing: 0.06em;
  }

  /* メニューを開いている間、背面のページはスクロールさせない */
  :global(html.is-nav-open),
  :global(html.is-nav-open body) {
    overflow: hidden;
  }

  /* ---------------- ナビ（PC） ---------------- */
  @media (min-width: 1000px) {
    .navToggle {
      display: none;
    }

    .site-nav {
      position: static;
      inset: auto;
      background: none;
      padding: 0;
      overflow: visible;
      visibility: visible;
      opacity: 1;
      transform: none;
      transition: none;
    }

    .site-nav__sub,
    .site-nav__tel {
      display: none;
    }

    .site-nav__list {
      grid-auto-flow: column;
      gap: 0.35rem;
      align-items: center;
    }

    .site-nav__list a {
      min-height: 44px;
      border: 0;
      font-size: 0.9375rem;
      padding-inline: 1rem;
      position: relative;
      letter-spacing: 0.06em;
    }

    .site-nav__list a::before {
      content: '';
      position: absolute;
      left: 1rem;
      right: 1rem;
      bottom: 0.55rem;
      height: 1px;
      background: var(--gold);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.24s ease;
    }

    .site-nav__list a:hover::before,
    .site-nav__list a[aria-current='page']::before,
    .site-nav__list a[data-section]::before {
      transform: scaleX(1);
    }

    .site-nav__list a[aria-current='page']::after {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .site-nav__list a::before {
        transition: none;
      }
    }
  }

  /* ---------------- 第2段ナビ ---------------- */
  .subnav {
    border-top: 1px solid var(--line-soft);
    background: var(--white);
  }

  .subnav__inner ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .subnav__inner a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 0.9rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--ink-70);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    border-bottom: 2px solid transparent;
  }

  .subnav__inner a:hover {
    color: var(--ai-700);
  }

  .subnav__inner a[aria-current='page'] {
    color: var(--ai-800);
    font-weight: 600;
    border-bottom-color: var(--gold);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (header && toggle && nav) {
    // ドロワーはヘッダーの下端から下を覆う。
    // 事業ページでは第2段ナビの分だけヘッダーが高くなるため、実寸を測って渡す。
    const syncHeaderHeight = () => {
      const h = Math.round(header.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--header-h', `${h}px`);
    };
    syncHeaderHeight();

    new ResizeObserver(syncHeaderHeight).observe(header);

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean) => {
      if (open) syncHeaderHeight();
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      // 背面のスクロール固定は html 側で行う。
      // body だけに overflow を掛けてもスクロールするのはドキュメント要素のため止まらない。
      document.documentElement.classList.toggle('is-nav-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(!isOpen());
    });

    // 同一ページ内リンクを押したときは遷移が起きないので、明示的に閉じる
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // デスクトップ幅へ戻したときに開閉状態をリセットする
    window.matchMedia('(min-width: 1000px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });

    // 履歴を戻って復元されたページでメニューが開いたままにならないようにする
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) setOpen(false);
    });
  }
</script>
